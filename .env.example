# Copy to .env and fill in the values from the X developer console.
# .env must never be committed.

# App-only authentication, used for public data (search, counts, user lookup).
X_BEARER_TOKEN=

# OAuth 1.0a consumer keys (not needed for public data collection).
X_API_KEY=
X_API_KEY_SECRET=

# OAuth 2.0 client credentials (not needed for public data collection).
X_CLIENT_ID=
X_CLIENT_SECRET=
